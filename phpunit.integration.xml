<?xml version="1.0" encoding="UTF-8"?>
<!--
    Config de test separada para el testsuite RadiographyIntegration: corre contra
    MySQL o MariaDB real (nunca SQLite) porque RadiographySnapshotBuilder y
    BranchRadiographyCalculator usan SQL propio de MySQL (REGEXP, JSON_EXTRACT,
    JSON_UNQUOTE) que SQLite no soporta. Ver app/Services/Radiography y
    tests/Integration/README.md para el comando exacto de uso y las variables de
    entorno requeridas (DB_TEST_HOST, DB_TEST_PORT, DB_TEST_DATABASE, etc).
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="RadiographyIntegration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- APP_ENV=testing.mysql hace que Laravel cargue .env.testing.mysql (convención
             .env con sufijo de entorno) en vez del .env.testing normal, que fuerza SQLite. -->
        <env name="APP_ENV" value="testing.mysql"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
