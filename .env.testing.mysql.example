# Copia este archivo a ".env.testing.mysql" y ajusta los valores a TU entorno.
#
# Uso:
#   php artisan test --configuration=phpunit.integration.xml --testsuite=RadiographyIntegration
#
# Este archivo (.env.testing.mysql.example) SÍ se versiona — es solo documentación,
# sin credenciales reales. Tu copia real ".env.testing.mysql" ya está en .gitignore.

APP_ENV=testing.mysql
APP_KEY=

# ── Conexión AISLADA de pruebas (config/database.php: connections.mysql_testing) ──
# RefreshDatabase / migraciones corren AQUÍ con seguridad. NUNCA apuntes
# DB_TEST_DATABASE a la base de datos de desarrollo o producción: se borraría.
# Crea una BD vacía y dedicada, ej.:  CREATE DATABASE reportes_test;
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=3306
DB_TEST_DATABASE=reportes_test
DB_TEST_USERNAME=root
DB_TEST_PASSWORD=
DB_CONNECTION=mysql_testing

# ── Conexión de SOLO LECTURA al dev/producción real ──
# Usada EXCLUSIVAMENTE por tests/Integration/*RealDataTest.php (Margarita/José/roster
# automático) para validar el pipeline contra datos históricos reales. Esos archivos
# JAMÁS usan RefreshDatabase ni escriben — solo GET/lectura. Si no configuras estas
# variables (o dejas DB_DATABASE vacío), esos tests se marcan skipped automáticamente.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=
